+}
+
+fn prefer_canonical(patched: PathBuf) -> PathBuf {
+    let Some(file_name) = patched.file_name() else {
+        return patched;
+    };
+    let Ok(directory) = env::var("ESP8266_WIFI_CANONICAL_PATCHED_SOURCES") else {
+        return patched;
+    };
+    let canonical = PathBuf::from(directory).join(file_name);
+    if !canonical.is_file() {
+        panic!("missing canonical source {}", canonical.display());
+    }
+    fs::copy(&canonical, &patched).unwrap_or_else(|error| {
+        panic!(
+            "failed to copy canonical source {}: {error}",
+            canonical.display()
+        )
+    });
     patched
 }
 
