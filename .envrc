esp_toolchain_dir="$(rustup run esp-1.80.0 rustc --print sysroot)"

PATH_add "$esp_toolchain_dir"/xtensa-esp-elf/*/xtensa-esp-elf/bin
PATH_add "$HOME"/.espressif/tools/xtensa-lx106-elf/*/xtensa-lx106-elf/bin
export LIBCLANG_PATH="$(find "$esp_toolchain_dir"/xtensa-esp32-elf-clang/*/esp-clang/lib -maxdepth 0 -type d | sort | tail -n1)"

export ESP8266_RTOS_SDK="$HOME/.espressif/ESP8266_RTOS_SDK"
export IDF_PATH="$ESP8266_RTOS_SDK"

source_env_if_exists .envrc.local
